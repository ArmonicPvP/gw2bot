# Create a Discord bot at https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-discord-bot-token

# Install the application in the server with the bot and applications.commands
# scopes. Enable Developer Mode in Discord, then copy the server ID. Commands
# are registered only in this server.
DISCORD_COMMAND_GUILD_ID=123456789012345678

# Optional: channel that receives the guild membership, raffle audit, feast
# stock and Trial member messages. It must belong to DISCORD_COMMAND_GUILD_ID.
# Leave it unset and the bot still starts, but nothing is posted to this
# channel, its description is not updated with the guild member count, and the
# diag previews do not run. The raffle contribution channel is separate and
# hard-coded: it keeps receiving ticket purchase embeds, reward-tier
# milestones and the six-hourly report either way.
DISCORD_NOTIFICATION_CHANNEL_ID=123456789012345678

# Optional: Enable detailed application diagnostics in console logs.
DEBUG=false

# Optional: Discord user ID that also receives feast stock alerts by DM.
# DISCORD_FEAST_NOTIFICATION_USER_ID=123456789012345678

# Optional, but set both together: create an API key with account and guilds
# permissions at https://account.arena.net/applications. Without both values
# the bot still starts, and Guild Storage polling, feast stock alerts, guild
# log polling, guild membership messages, raffle deposit tracking, the overdue
# Trial member report and the guild member count description are disabled;
# /raffle, /check and /track then answer with the variables to set.
GW2_API_KEY=replace-with-gw2-api-key

# Guild ID from /v2/account.guild_leader. The API key must lead this guild.
GW2_GUILD_ID=replace-with-guild-id

# Optional: Guild Storage polling interval in seconds. Minimum: 30.
GW2_POLL_INTERVAL_SECONDS=300

# Optional: Guild log polling interval in seconds. Minimum: 30.
GW2_GUILD_LOG_POLL_INTERVAL_SECONDS=60

# Optional: Guild member cache lifetime in seconds. Must be greater than zero.
GW2_GUILD_MEMBER_CACHE_SECONDS=900

# Optional: SQLite database path.
# Local default is data/gw2bot.db. The Docker image overrides it with
# /app/data/gw2bot.db.
# RAFFLE_DB_PATH=data/gw2bot.db

# Optional: Guild Wars 2 API base URL. Trailing slashes are removed.
# GW2_API_BASE_URL=https://api.guildwars2.com

# Optional: IANA timezone name used to interpret typed /event times, to name
# event threads, and to define weekly repeat days. Defaults to UTC.
# TZ=America/New_York

# Optional: Web calendar with Discord sign-in. When WEB_ENABLED=true, all of
# the other WEB_* and DISCORD_OAUTH_* values below are required.
# WEB_ENABLED=false

# Port the calendar listens on inside the container. Publish it in
# compose.yaml when enabled.
# WEB_PORT=2222

# Public base URL of the calendar without a trailing slash. Register
# <WEB_BASE_URL>/oauth/callback as a redirect URI on the bot's Discord
# application under OAuth2 in https://discord.com/developers/applications.
# Discord requires https except for localhost, and Secure session cookies
# are only sent when this URL is https, so terminate TLS at a reverse proxy.
# WEB_BASE_URL=https://calendar.example.com

# OAuth2 client credentials from the same Discord application as the bot
# (OAuth2 tab: Client ID and Client Secret).
# DISCORD_OAUTH_CLIENT_ID=123456789012345678
# DISCORD_OAUTH_CLIENT_SECRET=replace-with-discord-oauth-client-secret

# Secret that signs calendar session cookies. At least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# WEB_SESSION_SECRET=replace-with-generated-session-secret

# How long a calendar sign-in stays valid, in seconds. Defaults to 7 days.
# Guild membership is re-checked periodically on top of this, so a member who
# leaves or is banned loses access without waiting for the session to expire.
# WEB_SESSION_TTL_SECONDS=604800

# Supports VS Code test discovery and local module execution.
# This variable is not read by the bot configuration.
PYTHONPATH=src
