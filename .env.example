# Almost everything the bot uses is configured from Discord with /settings and
# stored in its database. Only the variables below stay here, because each one
# decides how the container itself starts.
#
# Upgrading from an older release? Leave your existing variables in place for
# one startup: the bot imports them into /settings once, then warns about each
# leftover until you delete it. See README.md, "Migrating From Environment
# Variables".

# Create a Discord bot at https://discord.com/developers/applications
DISCORD_TOKEN=

# Install the application in the server with the bot and applications.commands
# scopes. Enable Developer Mode in Discord, then copy the server ID. Commands
# are registered only in this server.
DISCORD_COMMAND_GUILD_ID=

# Optional: enable detailed application diagnostics in console logs.
DEBUG=false

# Optional: SQLite database path. It holds the raffle ledger, events, profit
# caches, member profit keys and /settings values. Local default is
# data/gw2bot.db; the Docker image
# overrides it with /app/data/gw2bot.db.
# RAFFLE_DB_PATH=

# Optional: key used to encrypt credential settings and member profit API keys.
# Leave it unset and the bot generates settings.key beside the database on
# first run,
# readable only by its owner. Set it to keep the key off the data volume, and
# back up whichever one you use: without it those secrets cannot be read.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; \
#              print(Fernet.generate_key().decode())"
# SETTINGS_ENCRYPTION_KEY=

# Optional: Guild Wars 2 API base URL. Trailing slashes are removed. It decides
# where the API key is sent, which is why it is not settable from Discord.
# GW2_API_BASE_URL=

# Optional: serve the web calendar and dashboards. This opens the listening
# port; its four credentials are configured with the commands below.
# Run /settings web_base_url,
# /settings discord_oauth_client_id, /settings discord_oauth_client_secret and
# /settings web_session_secret. Switching this on before they are set is not an
# error: the bot names the missing ones at startup and leaves the site off.
# WEB_ENABLED=false

# Port the web site listens on inside the container. Publish it in
# compose.yaml when enabled.
# WEB_PORT=2222

# Supports VS Code test discovery and local module execution.
# This variable is not read by the bot configuration.
PYTHONPATH=src
